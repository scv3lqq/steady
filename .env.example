# Copy to .env and export before starting steady. All values are optional.
# Listen address as host:port. Keep it on a loopback address.
STEADY_ADDR=127.0.0.1:8770
# Path of the SQLite file.
STEADY_DB=data/steady.db
# trace, debug, info, warn, error, fatal or panic.
STEADY_LOG_LEVEL=info
# Comma-separated extra Host values to accept behind a reverse proxy.
STEADY_ALLOWED_HOSTS=
# Keep true for an HTTPS reverse proxy. Forwarded headers never choose cookie security.
# Set false only for local loopback HTTP or an SSH tunnel, then restart steady.
STEADY_COOKIE_SECURE=true
